# EMA-BAND safe configuration template.
# Copy this file to .env and add your private credentials locally.
# NEVER commit .env.

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# DigitalOcean API (used by Telegram /do status commands only)
DIGITALOCEAN_API_TOKEN=
DIGITALOCEAN_DROPLET_ID=

ENABLE_LIVE_TRADING=false
# Virtual account seed used only by PAPER mode. No Bybit wallet balance is used.
PAPER_STARTING_CAPITAL_USDT=1000
# Paper-mode public market feed. Default false = mainnet public data even if BYBIT_TESTNET=true.
PAPER_MARKET_DATA_TESTNET=false
ENABLE_LONG=true
ENABLE_SHORT=false

STRATEGY_MODE=ema_band

# Position sizing
POSITION_SIZE_PCT=10
MIN_TRADE_USDT=5
MAX_ORDER_NOTIONAL_USDT=0
MAX_ACCOUNT_EXPOSURE_USDT=0

# Risk
LEVERAGE=3
MAX_LONG_ENTRIES=5
MAX_TOTAL_OPEN_LOTS=30
MAX_DAILY_LOSS_USDT=100
STOP_LOSS_PCT=30 # deprecated; retained only for backwards compatibility
LIQUIDATION_BUFFER_PCT=20
MAINTENANCE_MARGIN_RATE=0.005

# Strategy: EMA-BAND
EMA_BAND_FAST=200
EMA_BAND_SLOW=210
EMA_BAND_RSI_PERIOD=20
EMA_BAND_COOLDOWN_CANDLES=5
EMA_BAND_EXIT_CANDLES=0
EMA_BAND_EXIT_RSI=75

# Strategy: EMA+RSI
EMA_RSI_EMA_PERIOD=200
EMA_RSI_PERIOD=20
EMA_RSI_ENTRY_RSI=45
EMA_RSI_EXIT_RSI=80
EMA_RSI_COOLDOWN_CANDLES=0

TAKER_FEE_RATE=0.00055
EXIT_ON_CANDLE_CLOSE=true
MAX_SLIPPAGE_BPS=50
SCANNER_INTERVAL_SECONDS=120
RECONCILIATION_SECONDS=5
PNL_REVIEW_MINUTES=30
MAX_ENTRY_PRICE_DEVIATION_PCT=1.0
REQUIRE_LEVERAGE_CONFIRMATION=true
KILL_SWITCH_FILE=EMERGENCY_STOP
DASHBOARD_HOST=127.0.0.1
STUCK_ORDER_TIMEOUT_SECONDS=120

SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,SUIUSDT,NEARUSDT,APTUSDT,LTCUSDT,DOTUSDT,BCHUSDT,TRXUSDT,UNIUSDT,FILUSDT,ETCUSDT,INJUSDT,WIFUSDT,RENDERUSDT,TIAUSDT,ARBUSDT,OPUSDT,ATOMUSDT,SEIUSDT,STXUSDT,ORDIUSDT,AAVEUSDT,ICPUSDT,GALAUSDT,KASUSDT,JASMYUSDT,WLDUSDT,ARUSDT,ALGOUSDT,RUNEUSDT,THETAUSDT,ENAUSDT,NOTUSDT
