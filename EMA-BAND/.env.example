# Copy to .env, fill in secrets, and run: chmod 600 .env
# Start safely with testnet and paper mode.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
ENABLE_LIVE_TRADING=false

SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
ENABLE_LONG=true
ENABLE_SHORT=false

STRATEGY_MODE=ema_band
EMA_BAND_FAST=200
EMA_BAND_SLOW=210
EMA_BAND_RSI_PERIOD=20
EMA_BAND_COOLDOWN_CANDLES=5
EMA_BAND_EXIT_CANDLES=0
EMA_BAND_EXIT_RSI=75.0

EMA_RSI_EMA_PERIOD=200
EMA_RSI_PERIOD=20
EMA_RSI_ENTRY_RSI=45.0
EMA_RSI_EXIT_RSI=80.0
EMA_RSI_COOLDOWN_CANDLES=0

POSITION_SIZE_PCT=10.0
MAX_LONG_ENTRIES=5
MIN_TRADE_USDT=5.0
MAX_ORDER_NOTIONAL_USDT=25
MAX_ACCOUNT_EXPOSURE_USDT=0
MAX_TOTAL_OPEN_LOTS=5
MAX_DAILY_LOSS_USDT=25
LEVERAGE=3
STOP_LOSS_PCT=80.0
REQUIRE_LEVERAGE_CONFIRMATION=true
MAX_ENTRY_PRICE_DEVIATION_PCT=1.0
STUCK_ORDER_TIMEOUT_SECONDS=120
TAKER_FEE_RATE=0.00055
MAX_SLIPPAGE_BPS=50

SCANNER_INTERVAL_SECONDS=120
RECONCILIATION_SECONDS=5
PNL_REVIEW_MINUTES=30

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_HOURLY_PNL=false
TELEGRAM_PNL_INTERVAL_SECONDS=3600
TELEGRAM_NOTIFY_START_STOP=false
TELEGRAM_COMMANDS_ENABLED=true

DIGITALOCEAN_API_TOKEN=
# Optional: limit /digitalocean output to one droplet.
DIGITALOCEAN_DROPLET_ID=

KILL_SWITCH_FILE=EMERGENCY_STOP
CHECK_ENV_PERMISSIONS=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
